#!/bin/busybox sh
export PATH="/sbin:/bin:/usr/sbin:/usr/bin"
export TERM=linux

busybox ln -s busybox /bin/ln
ln -s busybox /bin/sh
ln -s busybox /bin/ls
ln -s busybox /bin/vi
ln -s busybox /bin/mount
ln -s busybox /bin/umount
ln -s busybox /bin/mkdir
ln -s busybox /bin/echo
ln -s busybox /bin/cat
ln -s busybox /bin/grep
ln -s busybox /bin/awk
ln -s busybox /bin/mknod
ln -s busybox /bin/switch_root
ln -s busybox /bin/blkid
ln -s busybox /bin/fsck
ln -s busybox /bin/sed

mkdir -p bin dev etc lib mnt proc sbin sys usr usr/bin usr/sbin

# 挂载虚拟文件系统
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# 探测根文件系统设备 (支持多种方式)
find_root() {
    # 1. 从内核参数获取
    root_device=$(cat /proc/cmdline | sed -n 's/.*root=\([^ ]*\).*/\1/p')
    [ -n "$root_device" ] && echo $root_device && return
    # 2. 自动发现
    for device in $(grep -E 'sd[a-z]|nvme|mmc|vd[a-z]' /proc/partitions | awk '{print $4}'); do
        if blkid /dev/$device | grep -q 'TYPE="ext4"'; then
            echo /dev/$device
            return
        fi
    done
    # 3. 如果都失败
    echo ""
}

# 挂载根文件系统
root=$(find_root)
echo "Found root device: ${root:-none}"
if [ -n "$root" ]; then
    # 首先以只读方式挂载检查完整性
    if ! mount -t ext4 -o ro $root /mnt; then
        echo "Read-only mount failed! Attempting repair..."
        fsck -t ext4 -y $root
        if ! mount -t ext4 -o ro $root /mnt; then
            echo "Repair failed! Dropping to shell"
            /bin/busybox sh
        fi
    fi

    # 检查最小系统文件
    if [ ! -x /mnt/init ] || [ ! -d /mnt/dev ]; then
        echo "Missing critical directories in rootfs! Dropping to shell"
        /bin/busybox sh
    fi

    # 卸载后重新以读写模式挂载
    umount /mnt
    if ! mount -t ext4 $root /mnt; then
        echo "Read-write mount failed! Dropping to shell"
        /bin/busybox sh
    fi

    # 切换到根文件系统
    echo "Successfully mounted rootfs in read-write mode"
    # /bin/busybox sh # 调试 initramfs
    # mount --move /proc /mnt/proc
    # mount --move /sys /mnt/sys
    # mount --move /dev /mnt/dev
    cd /mnt
    exec switch_root . /init
else
    echo "ERROR: No root filesystem found!" >&2
    /bin/busybox sh
fi